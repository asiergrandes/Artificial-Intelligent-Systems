{
  "preprocessing": {
    "text_process": "tf-idf",
    "sampling": "undersampling"
  },

  "kNN": {
    "n_neighbors": [5, 7, 9, 11, 13],
    "weights": ["uniform"],
    "metric": ["euclidean", "manhattan"]
  },

  "decision_tree": {
    "max_depth": [3, 5, 6],
    "criterion":["gini", "entropy"]
  },

  "random_forest": {
    "max_depth": [3, 5, 6],
    "criterion": ["gini", "entropy"],
    "min_samples_split":[2],
    "min_samples_leaf": [2]
  },

  "naive_bayes": {
    "alpha": [0.001,0.01, 0.1, 1.0, 1.5, 2.0],
    "fit_prior": [true, false]
  }

}